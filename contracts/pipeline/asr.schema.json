{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline/asr.schema.json",
  "$defs": {
    "AsrSegment": {
      "additionalProperties": false,
      "properties": {
        "start_sec": {
          "minimum": 0,
          "title": "Start Sec",
          "type": "number"
        },
        "end_sec": {
          "title": "End Sec",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "avg_logprob": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Avg Logprob"
        },
        "no_speech_prob": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "No Speech Prob"
        },
        "compression_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Compression Ratio"
        },
        "words": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Word"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "start_sec",
        "end_sec",
        "text",
        "avg_logprob",
        "no_speech_prob",
        "compression_ratio",
        "words"
      ],
      "title": "AsrSegment",
      "type": "object"
    },
    "PipelineWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "message"
      ],
      "title": "PipelineWarning",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "preprocess",
        "vad",
        "asr",
        "diarize",
        "merge",
        "summarize"
      ],
      "title": "Stage",
      "type": "string"
    },
    "Word": {
      "additionalProperties": false,
      "properties": {
        "w": {
          "minLength": 1,
          "title": "W",
          "type": "string"
        },
        "s": {
          "minimum": 0,
          "title": "S",
          "type": "number"
        },
        "e": {
          "minimum": 0,
          "title": "E",
          "type": "number"
        },
        "p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P"
        }
      },
      "required": [
        "w",
        "s",
        "e",
        "p"
      ],
      "title": "Word",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/AsrSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PipelineWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "model",
    "language",
    "segments",
    "warnings"
  ],
  "title": "AsrOutput",
  "type": "object"
}
