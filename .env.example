# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/meeting_assistant

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_placeholder

# External AI Services (Worker)
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
HF_TOKEN=your_huggingface_token_placeholder
LLM_PROVIDER=fake

# AI Pipeline Configuration
PIPELINE_BACKEND=fake
# Kịch bản của fake pipeline: ok, slow, transient_once, permanent, timeout, no_speech,
# diarize_fail, summary_fail, summary_flaky, summary_disabled (pipeline/README.md)
FAKE_SCENARIO=ok
# ASR thật, mặc định theo docs/adr/0001-asr.md
ASR_MODEL=large-v3-turbo
ASR_COMPUTE_TYPE=int8_float16
ASR_DEVICE=cuda
ASR_BEAM_SIZE=5

# Application Limits & Storage
MAX_UPLOAD_MB=200
AUDIO_RETENTION_DAYS=14
OPERATIONAL_RETENTION_DAYS=28

# Pool kết nối DB (tổng phải nhỏ hơn max_connections của Postgres)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=30
# DB_POOL_TIMEOUT_SEC=10
# Số request xử lý cùng lúc MỖI process API (phải <= DB_POOL_SIZE + DB_MAX_OVERFLOW và <= 40 thread).
# Nhiều process: tổng kết nối ~ số process x API_MAX_INFLIGHT, giữ dưới max_connections của Postgres.
# API_WORKERS=1
# API_MAX_INFLIGHT=40
# API_QUEUE_TIMEOUT_SEC=10
