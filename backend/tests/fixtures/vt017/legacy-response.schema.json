{
  "$ref": "#/components/schemas/MeetingListOut",
  "components": {
    "schemas": {
      "MeetingArtifactsOut": {
        "properties": {
          "transcript": {
            "type": "string",
            "title": "Transcript",
            "description": "Trạng thái transcript (pending/ready/failed)"
          },
          "diarization": {
            "type": "string",
            "title": "Diarization",
            "description": "Trạng thái diarization (ok/fallback/pending/failed)"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "Trạng thái summary (pending/ready/failed/insufficient_content/disabled)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcript",
          "diarization",
          "summary"
        ],
        "title": "MeetingArtifactsOut",
        "description": "Trạng thái các artifact AI của cuộc họp."
      },
      "MeetingAudioOut": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available",
            "description": "Cờ xác định file audio có sẵn để nghe/tải không"
          },
          "mime_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mime Type",
            "description": "MIME type của file audio"
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes",
            "description": "Dung lượng file tính bằng bytes"
          },
          "retention_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retention Until",
            "description": "Thời điểm hết hạn lưu trữ audio theo retention policy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "available"
        ],
        "title": "MeetingAudioOut",
        "description": "Thông tin file audio của cuộc họp."
      },
      "MeetingListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MeetingOut"
            },
            "type": "array",
            "title": "Items",
            "description": "Danh sách các cuộc họp"
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Số thứ tự trang hiện tại (bắt đầu từ 1)"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "description": "Số lượng mục trên mỗi trang"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Tổng số cuộc họp thỏa mãn điều kiện lọc"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "MeetingListOut",
        "description": "Danh sách cuộc họp có phân trang."
      },
      "MeetingOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "UUID của cuộc họp"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Tiêu đề cuộc họp"
          },
          "source": {
            "type": "string",
            "enum": [
              "upload",
              "recording"
            ],
            "title": "Source",
            "description": "Nguồn audio (upload hoặc recording)"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "ready",
              "partial",
              "failed"
            ],
            "title": "Status",
            "description": "Trạng thái xử lý tổng thể của cuộc họp"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Ngôn ngữ chính (mặc định 'vi')",
            "default": "vi"
          },
          "meeting_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meeting Date",
            "description": "Ngày diễn ra cuộc họp định dạng YYYY-MM-DD"
          },
          "duration_sec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Sec",
            "description": "Thời lượng audio tính bằng giây"
          },
          "num_speakers_hint": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Num Speakers Hint",
            "description": "Số lượng người nói gợi ý từ người dùng"
          },
          "audio": {
            "$ref": "#/components/schemas/MeetingAudioOut",
            "description": "Thông tin tệp âm thanh"
          },
          "artifacts": {
            "$ref": "#/components/schemas/MeetingArtifactsOut",
            "description": "Trạng thái các artifacts được sinh ra"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Danh sách các cảnh báo xử lý"
          },
          "latest_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Job Id",
            "description": "UUID của job xử lý gần nhất"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string"
              }
            ],
            "title": "Created At",
            "description": "Thời điểm tạo cuộc họp ISO 8601 UTC"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string"
              }
            ],
            "title": "Updated At",
            "description": "Thời điểm cập nhật gần nhất ISO 8601 UTC"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "description": "Phiên bản phục vụ optimistic locking",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "source",
          "status",
          "audio",
          "artifacts",
          "created_at",
          "updated_at"
        ],
        "title": "MeetingOut",
        "description": "Schema thông tin Cuộc họp theo hợp đồng REST API."
      }
    }
  }
}
